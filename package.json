{
  "name": "gotoolkit",
  "version": "2026.1.3",
  "description": "Go-Toolkit combine deux expériences pensées pour les consultants : **Go-Slides** (pour créer des planches claires et structurées) et **Go-Timeline** (pour visualiser et ajuster un planning). Chaque outil s’utilise en ouvrant directement son fichier dans un navigateur, avec des assistants IA, des exports réactifs et des modèles prêts à l’emploi.",
  "main": "index.js",
  "scripts": {
    "start": "npx serve public -l 5000",
    "build": "npm run build:connect && npm run build:memo",
    "build:connect": "esbuild src/connect/index.tsx --bundle --format=iife --platform=browser --target=es2018 --sourcemap --minify-identifiers --define:process.env.NODE_ENV=\\\"'production'\\\" --outdir=public/js --entry-names=connect.bundle --asset-names=assets/[name]-[hash] --loader:.css=text --loader:.woff=file --loader:.woff2=file --loader:.ttf=file --loader:.svg=file --loader:.png=file",
    "build:memo": "esbuild src/memo/index.tsx --bundle --format=iife --platform=browser --target=es2018 --sourcemap --minify-identifiers --define:process.env.NODE_ENV=\\\"'production'\\\" --outdir=public/js --entry-names=memo.bundle --asset-names=assets/[name]-[hash] --alias:@=./src",
    "test:playwright": "npx playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quangfr/goroadmap.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/quangfr/goroadmap/issues"
  },
  "homepage": "https://github.com/quangfr/goroadmap#readme",
  "dependencies": {
    "@excalidraw/excalidraw": "^0.17.6",
    "@excalidraw/mermaid-to-excalidraw": "^2.0.0",
    "@tiptap/core": "^2.27.1",
    "@tiptap/extension-bubble-menu": "^2.27.1",
    "@tiptap/extension-highlight": "^2.27.1",
    "@tiptap/extension-image": "^2.27.1",
    "@tiptap/extension-link": "^2.27.1",
    "@tiptap/extension-placeholder": "^2.27.1",
    "@tiptap/extension-subscript": "^2.27.1",
    "@tiptap/extension-superscript": "^2.27.1",
    "@tiptap/extension-table": "^2.27.1",
    "@tiptap/extension-table-cell": "^2.27.1",
    "@tiptap/extension-table-header": "^2.27.1",
    "@tiptap/extension-table-row": "^2.27.1",
    "@tiptap/extension-task-item": "^2.27.1",
    "@tiptap/extension-task-list": "^2.27.1",
    "@tiptap/extension-text-align": "^2.27.1",
    "@tiptap/extension-underline": "^2.27.1",
    "@tiptap/pm": "^2.27.1",
    "@tiptap/react": "^2.27.1",
    "@tiptap/starter-kit": "^2.27.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.27.1",
    "playwright": "^1.57.0",
    "serve": "^14.2.5"
  }
}
