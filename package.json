{
  "name": "gotoolkit",
  "version": "2026.02.19.4",
  "description": "Go-Toolkit combine deux expériences pensées pour les consultants : **Go-Slides** (pour créer des planches claires et structurées) et **Go-Timeline** (pour visualiser et ajuster un planning). Chaque outil s’utilise en ouvrant directement son fichier dans un navigateur, avec des assistants IA, des exports réactifs et des modèles prêts à l’emploi.",
  "main": "index.js",
  "scripts": {
    "start": "serve ./public -l 5000 --config serve.json",
    "dev": "concurrently \"npm run dev:connect\" \"npm run dev:memo\" \"npm run start\"",
    "dev:connect": "esbuild src/draw-editor/index.tsx --bundle --format=iife --platform=browser --target=es2018 --sourcemap --define:process.env.NODE_ENV=\"'development'\" --define:process.env=\"{}\" --define:global=\"window\" --inject:src/polyfills.ts --alias:react=./src/react-shim.ts --alias:react/jsx-runtime=./src/jsx-runtime-shim.ts --alias:react-dom=./src/react-dom-shim.ts --alias:react-dom/client=./src/react-dom-shim.ts --alias:mermaid=./src/mermaid-shim.ts --alias:@excalidraw/excalidraw=./src/excalidraw-shim.ts --outdir=public/js --entry-names=draw.bundle --asset-names=assets/[name]-[hash] --loader:.css=text --loader:.woff=file --loader:.woff2=file --loader:.ttf=file --loader:.svg=file --loader:.png=file --watch",
    "dev:memo": "esbuild src/memo-bridge/index.tsx --bundle --format=iife --platform=browser --target=es2018 --sourcemap --define:process.env.NODE_ENV=\"'development'\" --define:process.env=\"{}\" --define:global=\"window\" --inject:src/polyfills.ts --alias:react=./src/react-shim.ts --alias:react/jsx-runtime=./src/jsx-runtime-shim.ts --alias:react-dom=./src/react-dom-shim.ts --alias:react-dom/client=./src/react-dom-shim.ts --alias:mermaid=./src/mermaid-shim.ts --alias:@excalidraw/excalidraw=./src/excalidraw-shim.ts --outdir=public/js --entry-names=memo.bundle --asset-names=assets/[name]-[hash] --alias:@=./src --watch",
    "build": "concurrently \"npm run build:connect\" \"npm run build:memo\"",
    "build:prod": "concurrently \"npm run build:connect:prod\" \"npm run build:memo:prod\"",
    "build:connect": "esbuild src/draw-editor/index.tsx --bundle --format=iife --platform=browser --target=es2018 --define:process.env.NODE_ENV=\"'development'\" --define:process.env=\"{}\" --define:global=\"window\" --inject:src/polyfills.ts --alias:react=./src/react-shim.ts --alias:react/jsx-runtime=./src/jsx-runtime-shim.ts --alias:react-dom=./src/react-dom-shim.ts --alias:react-dom/client=./src/react-dom-shim.ts --alias:mermaid=./src/mermaid-shim.ts --alias:@excalidraw/excalidraw=./src/excalidraw-shim.ts --outdir=public/js --entry-names=draw.bundle --asset-names=assets/[name]-[hash] --loader:.css=text --loader:.woff=file --loader:.woff2=file --loader:.ttf=file --loader:.svg=file --loader:.png=file",
    "build:connect:prod": "esbuild src/draw-editor/index.tsx --bundle --format=iife --platform=browser --target=es2018 --sourcemap --minify --define:process.env.NODE_ENV=\"'production'\" --define:process.env=\"{}\" --define:global=\"window\" --inject:src/polyfills.ts --alias:react=./src/react-shim.ts --alias:react/jsx-runtime=./src/jsx-runtime-shim.ts --alias:react-dom=./src/react-dom-shim.ts --alias:react-dom/client=./src/react-dom-shim.ts --alias:mermaid=./src/mermaid-shim.ts --alias:@excalidraw/excalidraw=./src/excalidraw-shim.ts --outdir=public/js --entry-names=draw.bundle --asset-names=assets/[name]-[hash] --loader:.css=text --loader:.woff=file --loader:.woff2=file --loader:.ttf=file --loader:.svg=file --loader:.png=file",
    "build:memo": "esbuild src/memo-bridge/index.tsx --bundle --format=iife --platform=browser --target=es2018 --define:process.env.NODE_ENV=\"'development'\" --define:process.env=\"{}\" --define:global=\"window\" --inject:src/polyfills.ts --alias:react=./src/react-shim.ts --alias:react/jsx-runtime=./src/jsx-runtime-shim.ts --alias:react-dom=./src/react-dom-shim.ts --alias:react-dom/client=./src/react-dom-shim.ts --alias:mermaid=./src/mermaid-shim.ts --alias:@excalidraw/excalidraw=./src/excalidraw-shim.ts --outdir=public/js --entry-names=memo.bundle --asset-names=assets/[name]-[hash] --alias:@=./src",
    "build:memo:prod": "esbuild src/memo-bridge/index.tsx --bundle --format=iife --platform=browser --target=es2018 --sourcemap --minify --define:process.env.NODE_ENV=\"'production'\" --define:process.env=\"{}\" --define:global=\"window\" --inject:src/polyfills.ts --alias:react=./src/react-shim.ts --alias:react/jsx-runtime=./src/jsx-runtime-shim.ts --alias:react-dom=./src/react-dom-shim.ts --alias:react-dom/client=./src/react-dom-shim.ts --alias:mermaid=./src/mermaid-shim.ts --alias:@excalidraw/excalidraw=./src/excalidraw-shim.ts --outdir=public/js --entry-names=memo.bundle --asset-names=assets/[name]-[hash] --alias:@=./src",
    "bump": "node scripts/version-bump.js",
    "test:playwright": "npx playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quangfr/goroadmap.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/quangfr/goroadmap/issues"
  },
  "homepage": "https://github.com/quangfr/goroadmap#readme",
  "dependencies": {
    "@excalidraw/excalidraw": "^0.17.6",
    "@excalidraw/mermaid-to-excalidraw": "^2.0.0",
    "@floating-ui/dom": "^1.7.4",
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-bubble-menu": "^2.11.5",
    "@tiptap/extension-color": "^2.11.5",
    "@tiptap/extension-details": "^2.11.5",
    "@tiptap/extension-details-content": "^2.11.5",
    "@tiptap/extension-details-summary": "^2.11.5",
    "@tiptap/extension-emoji": "^2.11.5",
    "@tiptap/extension-heading": "^2.27.2",
    "@tiptap/extension-highlight": "^2.11.5",
    "@tiptap/extension-history": "^2.11.5",
    "@tiptap/extension-image": "^2.11.5",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-subscript": "^2.11.5",
    "@tiptap/extension-superscript": "^2.11.5",
    "@tiptap/extension-table": "^2.11.5",
    "@tiptap/extension-table-cell": "^2.11.5",
    "@tiptap/extension-table-header": "^2.11.5",
    "@tiptap/extension-table-of-contents": "^2.27.2",
    "@tiptap/extension-table-row": "^2.11.5",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/extension-text-align": "^2.11.5",
    "@tiptap/extension-text-style": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "@tiptap/suggestion": "^2.11.5",
    "buffer": "^6.0.3",
    "docx": "^9.5.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.562.0",
    "marked": "^12.0.2",
    "process": "^0.11.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tippy.js": "^6.3.7",
    "tiptap-extension-mermaid": "^0.0.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "browser-sync": "^3.0.4",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.1",
    "playwright": "^1.57.0",
    "serve": "^14.2.5"
  }
}
