{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Dev + Live Reload",
			"type": "shell",
			"command": "npm run dev",
			"isBackground": true,
			"problemMatcher": {
				"pattern": {
					"regexp": "^.*$",
					"file": 1,
					"location": 2,
					"message": 3
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "esbuild|browser-sync",
					"endsPattern": "watch|Local:"
				}
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "Build Project",
			"label": "Build",
			"type": "shell",
			"command": "npm run build",
			"problemMatcher": [],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "Dev + Serve public",
			"dependsOrder": "sequence",
			"dependsOn": [
				"Build",
				"Dev",
				"Serve public"
			],
			"problemMatcher": []
		},
		{
			"label": "Build Project",
			"type": "shell",
			"command": "npm run build"
		}
	]
}