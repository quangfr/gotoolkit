{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Chrome (Local 5000)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5000/",
      "webRoot": "${workspaceFolder}/public",
      "preLaunchTask": "Dev",
      "runtimeArgs": [
        "--disable-features=SpellCheck"
      ]
    }
  ]
}
