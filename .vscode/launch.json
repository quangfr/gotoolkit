{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Chrome (Serve public)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5000/index.html",
      "webRoot": "${workspaceFolder}/public",
      "preLaunchTask": "Dev + Serve public",
      "runtimeArgs": [
        "--disable-features=SpellCheck"
      ]
    }
  ]
}
