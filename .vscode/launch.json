{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Chrome (Firebase Hosting main)",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5000/",
      "webRoot": "${workspaceFolder}/public",
      "preLaunchTask": "Dev + Firebase Hosting Emulator",
      "runtimeArgs": [
        "--disable-features=SpellCheck"
      ]
    }
  ]
}
