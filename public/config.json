{
  "voice": {
    "hideSummaryColumn": true,
    "disableCamera": true
  },
  "memo": {
    "contextEmbeddings": {
      "retentionDays": 7
    },
    "documentPreview": {
      "showChunksForMarkdown": false,
      "showChunksForPdf": true,
      "showChunksForOtherFormats": true
    }
  },
  "features": {
    "hideTimeline": true,
    "hideVoice": true
  },
  "fileImport": {
    "supportedExtensions": {
      "mimeTypes": [
        "application/pdf",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "text/plain",
        "text/markdown",
        "application/json",
        "application/rtf",
        "application/msword",
        "application/vnd.oasis.opendocument.text",
        "application/vnd.oasis.opendocument.spreadsheet"
      ],
      "extensions": [
        ".pdf",
        ".docx",
        ".pptx",
        ".xlsx",
        ".txt",
        ".md",
        ".json",
        ".hag",
        ".rtf",
        ".doc",
        ".odt",
        ".ods"
      ]
    },
    "fileSizeLimits": {
      "text": {
        "maxMB": 5,
        "extensions": [".txt", ".md"]
      },
      "structuredData": {
        "maxMB": 2,
        "extensions": [".json", ".csv", ".hag"]
      },
      "document": {
        "maxMB": 5,
        "extensions": [".pdf", ".docx", ".doc", ".odt", ".rtf"]
      },
      "presentation": {
        "maxMB": 5,
        "extensions": [".pptx"]
      },
      "spreadsheet": {
        "maxMB": 5,
        "extensions": [".xlsx", ".ods"]
      }
    }
  }
}
