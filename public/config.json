{
  "voice": {
    "hideSummaryColumn": true,
    "disableCamera": true
  },
  "memo": {
    "contextEmbeddings": {
      "retentionDays": 7
    },
    "import": {
      "directPasteEnabled": false
    },
    "documentPreview": {
      "showChunksForMarkdown": false,
      "showChunksForPdf": true,
      "showChunksForOtherFormats": true
    },
    "ocr": {
      "disableOffline": false
    }
  },
  "features": {
    "hideTimeline": true,
    "hideVoice": false
  },
  "fileImport": {
    "allowOverLimitEmbeddings": true,
    "supportedExtensions": {
      "mimeTypes": [
        "application/pdf",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "text/plain",
        "text/markdown",
        "application/json",
        "application/rtf",
        "application/msword",
        "application/vnd.oasis.opendocument.text",
        "application/vnd.oasis.opendocument.spreadsheet",
        "image/png",
        "image/jpeg",
        "image/webp",
        "image/gif",
        "image/bmp",
        "image/tiff"
      ],
      "extensions": [
        ".pdf",
        ".docx",
        ".pptx",
        ".xlsx",
        ".txt",
        ".md",
        ".json",
        ".hag",
        ".rtf",
        ".doc",
        ".odt",
        ".ods",
        ".png",
        ".jpg",
        ".jpeg",
        ".webp",
        ".gif",
        ".bmp",
        ".tif",
        ".tiff"
      ]
    },
    "fileSizeLimits": {
      "text": {
        "maxMB": 5,
        "extensions": [".txt", ".md"],
        "useCloudEmbeddings": false
      },
      "structuredData": {
        "maxMB": 5,
        "extensions": [".json", ".csv", ".hag"],
        "useCloudEmbeddings": true
      },
      "document": {
        "maxMB": 5,
        "extensions": [".pdf", ".docx", ".doc", ".odt", ".rtf"],
        "useCloudEmbeddings": false
      },
      "presentation": {
        "maxMB": 5,
        "extensions": [".pptx"],
        "useCloudEmbeddings": false
      },
      "spreadsheet": {
        "maxMB": 5,
        "extensions": [".xlsx", ".ods"],
        "useCloudEmbeddings": true
      },
      "image": {
        "maxMB": 20,
        "extensions": [".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp", ".tif", ".tiff"],
        "useCloudEmbeddings": false
      },
      "audio": {
        "maxMB": 20,
        "extensions": [".mp3", ".wav", ".mp4", ".m4a", ".aac", ".ogg", ".webm", ".flac"],
        "useCloudEmbeddings": false
      },
      "media": {
        "maxMB": 100,
        "extensions": [".mp4", ".webm", ".mov", ".avi"],
        "useCloudEmbeddings": false
      }
    }
  }
}
